{
  "name": "streaming-service",
  "version": "1.0.0",
  "description": "Streaming service for Srota backend",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "NODE_ENV=development node dist/index.js",
    "start:testing": "NODE_ENV=testing node dist/index.js",
    "start:staging": "NODE_ENV=staging node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:testing": "NODE_ENV=testing nodemon --exec ts-node src/index.ts",
    "dev:staging": "NODE_ENV=staging nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:generate": "node scripts/prisma-env.js generate",
    "db:push": "node scripts/prisma-env.js db push",
    "db:migrate": "node scripts/prisma-env.js migrate dev",
    "db:migrate:deploy": "node scripts/prisma-env.js migrate deploy",
    "db:reset": "node scripts/prisma-env.js migrate reset",
    "db:studio": "node scripts/prisma-env.js studio",
    "db:generate:dev": "NODE_ENV=development node scripts/prisma-env.js generate",
    "db:generate:testing": "NODE_ENV=testing node scripts/prisma-env.js generate",
    "db:generate:staging": "NODE_ENV=staging node scripts/prisma-env.js generate",
    "db:generate:production": "NODE_ENV=production node scripts/prisma-env.js generate",
    "db:push:dev": "NODE_ENV=development node scripts/prisma-env.js db push",
    "db:push:testing": "NODE_ENV=testing node scripts/prisma-env.js db push",
    "db:push:staging": "NODE_ENV=staging node scripts/prisma-env.js db push",
    "db:push:production": "NODE_ENV=production node scripts/prisma-env.js db push",
    "db:migrate:dev": "NODE_ENV=development node scripts/prisma-env.js migrate dev",
    "db:migrate:testing": "NODE_ENV=testing node scripts/prisma-env.js migrate dev",
    "db:migrate:staging": "NODE_ENV=staging node scripts/prisma-env.js migrate dev",
    "db:migrate:production": "NODE_ENV=production node scripts/prisma-env.js migrate dev",
    "db:migrate:deploy:testing": "NODE_ENV=testing node scripts/prisma-env.js migrate deploy",
    "db:migrate:deploy:staging": "NODE_ENV=staging node scripts/prisma-env.js migrate deploy",
    "db:migrate:deploy:production": "NODE_ENV=production node scripts/prisma-env.js migrate deploy",
    "db:reset:dev": "NODE_ENV=development node scripts/prisma-env.js migrate reset",
    "db:reset:testing": "NODE_ENV=testing node scripts/prisma-env.js migrate reset",
    "db:reset:staging": "NODE_ENV=staging node scripts/prisma-env.js migrate reset",
    "db:reset:production": "NODE_ENV=production node scripts/prisma-env.js migrate reset",
    "db:studio:dev": "NODE_ENV=development node scripts/prisma-env.js studio",
    "db:studio:testing": "NODE_ENV=testing node scripts/prisma-env.js studio",
    "db:studio:staging": "NODE_ENV=staging node scripts/prisma-env.js studio",
    "db:studio:production": "NODE_ENV=production node scripts/prisma-env.js studio",
    "rewrite-playlist-urls": "ts-node scripts/rewrite-bit-transcode-urls.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "streaming",
    "audio"
  ],
  "author": "Srota",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.911.0",
    "@aws-sdk/s3-request-presigner": "^3.911.0",
    "@bull-board/api": "^5.10.0",
    "@bull-board/express": "^5.10.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^6.17.1",
    "@types/amqplib": "^0.10.7",
    "@types/express-session": "^1.18.2",
    "@types/ioredis": "^4.28.10",
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "bull": "^4.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.17.1",
    "redis": "^5.8.3"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
